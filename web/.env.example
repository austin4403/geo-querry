# Neon Auth Configuration
# See: https://neon.com/docs/auth/overview
# Copy your Auth URL from Neon Console (Project -> Branch -> Auth -> Configuration)
NEON_AUTH_BASE_URL=https://ep-sample-pooler.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace_with_32_byte_secure_secret_for_session_encryption

# Go Core ConnectRPC Backend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/events
