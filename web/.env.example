# Neon Auth (Managed Better Auth) — vanilla setup
# See: https://neon.com/docs/auth/overview
# Copy the Auth URL from Neon Console (Project -> Auth -> Configuration)
NEON_AUTH_BASE_URL=
# At least 32 characters. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Go Core ConnectRPC Backend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/events
